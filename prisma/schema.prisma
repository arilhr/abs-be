generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  STAFF
}

model User {
  id        Int       @id @default(autoincrement())
  pegawaiId Int?
  username  String    @unique
  password  String
  role      UserRole  @default(STAFF)
  isActive  Boolean   @default(true)
  isArchive Boolean   @default(false)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  pegawai        Pegawai?        @relation(fields: [pegawaiId], references: [id])
  requestLemburs RequestLembur[]
}

model Position {
  id           Int        @id @default(autoincrement())
  name         String
  departmentId Int
  isArchive    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  pegawais     Pegawai[]
  department   Department @relation(fields: [departmentId], references: [id])
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String
  isArchive Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  positions Position[]
}

model Pegawai {
  id         Int     @id @default(autoincrement())
  pegawaiId  String  @unique
  name       String
  positionId Int
  status     String?
  salary     Int     @default(0)

  isArchive Boolean      @default(false)
  jadwals   Jadwal[]
  logs      LogAbsensi[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  position                 Position         @relation(fields: [positionId], references: [id])
  requestLemburs           RequestLembur[]  @relation("PegawaiRequestLembur")
  supervisedRequestLemburs RequestLembur[]  @relation("SupervisorRequestLembur")
  users                    User[]
  pengajuanIzins           PengajuanIzin[]  @relation("PegawaiPengajuanIzin")
  supervisedPengajuanIzins PengajuanIzin[]  @relation("SupervisorPengajuanIzin")
  logScans                 LogScan[]
  jadwalOverrides          JadwalOverride[]

  @@index([positionId])
}

model Shift {
  id                           Int              @id @default(autoincrement())
  name                         String
  jamMasuk                     String
  jamKeluar                    String
  isActive                     Boolean          @default(true)
  isArchive                    Boolean          @default(false)
  jadwals                      Jadwal[]
  logs                         LogAbsensi[]
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt
  requestLemburs               RequestLembur[]
  jadwalOverridesAsOriginal    JadwalOverride[] @relation("OriginalShift")
  jadwalOverridesAsReplacement JadwalOverride[] @relation("ReplacementShift")
}

model Jadwal {
  id        Int      @id @default(autoincrement())
  pegawaiId Int
  shiftId   Int
  day       Int
  isActive  Boolean  @default(true)
  isArchive Boolean  @default(false)
  pegawai   Pegawai  @relation(fields: [pegawaiId], references: [id])
  shift     Shift    @relation(fields: [shiftId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pegawaiId])
  @@index([shiftId])
}

model JadwalOverride {
  id              Int      @id @default(autoincrement())
  pegawaiId       Int
  date            DateTime // Tanggal spesifik pergantian
  originalShiftId Int? // Shift asli yang diganti (null = menambah shift baru)
  shiftId         Int? // Shift pengganti (null = libur/hapus shift)
  reason          String? // Alasan pergantian
  isActive        Boolean  @default(true)
  isArchive       Boolean  @default(false)

  pegawai       Pegawai @relation(fields: [pegawaiId], references: [id])
  originalShift Shift?  @relation("OriginalShift", fields: [originalShiftId], references: [id])
  shift         Shift?  @relation("ReplacementShift", fields: [shiftId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique: satu pegawai hanya bisa punya 1 override per tanggal per shift asli
  @@unique([pegawaiId, date, originalShiftId])
  @@index([pegawaiId])
  @@index([date])
  @@index([shiftId])
  @@index([originalShiftId])
}

model LogAbsensi {
  id            Int       @id @default(autoincrement())
  pegawaiId     Int
  shiftId       Int?
  shiftName     String
  day           Int
  jamMasuk      String
  jamMasukDate  DateTime
  jamKeluar     String
  jamKeluarDate DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  isLembur      Boolean   @default(false)
  isArchive     Boolean   @default(false)

  pegawai Pegawai @relation(fields: [pegawaiId], references: [id])
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  requestLembur RequestLembur?

  createdAt DateTime  @default(now())
  logScans  LogScan[]

  @@index([pegawaiId])
  @@index([shiftId])
}

model RequestLembur {
  id           Int      @id @default(autoincrement())
  userId       Int
  supervisorId Int?
  pegawaiId    Int
  shiftId      Int
  logAbsensiId Int?     @unique
  date         DateTime
  reason       String?
  isAccepted   Boolean?

  user       User        @relation(fields: [userId], references: [id])
  supervisor Pegawai?    @relation("SupervisorRequestLembur", fields: [supervisorId], references: [id])
  pegawai    Pegawai     @relation("PegawaiRequestLembur", fields: [pegawaiId], references: [id])
  shift      Shift       @relation(fields: [shiftId], references: [id])
  logAbsensi LogAbsensi? @relation(fields: [logAbsensiId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([supervisorId])
  @@index([pegawaiId])
  @@index([shiftId])
}

model PengajuanIzin {
  id Int @id @default(autoincrement())

  pegawaiId    Int
  supervisorId Int?
  date         DateTime
  reason       String?
  isAccepted   Boolean?

  pegawai    Pegawai  @relation("PegawaiPengajuanIzin", fields: [pegawaiId], references: [id])
  supervisor Pegawai? @relation("SupervisorPengajuanIzin", fields: [supervisorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supervisorId])
}

model AppConfig {
  id          String  @id @default(uuid())
  key         String  @unique
  value       Json
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ScanType {
  IN
  OUT
  UNKNOWN
}

model LogScan {
  id           Int      @id @default(autoincrement())
  pegawaiId    Int
  scanTime     DateTime
  scanType     ScanType
  logAbsensiId Int?

  createdAt DateTime @default(now())

  logAbsensi LogAbsensi? @relation(fields: [logAbsensiId], references: [id])
  pegawai    Pegawai     @relation(fields: [pegawaiId], references: [id])

  @@index([pegawaiId])
  @@index([logAbsensiId])
}
